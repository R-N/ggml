#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

#include "types.glsl"

layout (push_constant) uniform parameter
{
    BDA_STORAGE_T dst_addr;
    uint batch_offset; uint offset_delta;
    uint IC;
    uint IW; uint IH;
    uint OW; uint OH;
    uint KW; uint KH;
    uint OH_batch;
    uint CHW;
    int s0; int s1;
    int p0; int p1;
    int d0; int d1;
    uint batch_IC;
} p;

layout(constant_id = 0) const uint BLOCK_SIZE = 32;

// A workgroup transposes a tile of TILE output rows (flattened batch/oh/ow) x TILE CHW columns through shared
// memory: reads walk along ow, so neighbouring threads read neighbouring input pixels, and writes walk along CHW.
#define TILE 64
#define WG_SIZE 256
#define ROW_STEP (WG_SIZE / TILE)

layout(local_size_x = WG_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer X {A_TYPE data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};
#if D_SIZE == 2 && !BDA
layout (binding = 1) writeonly buffer D2 {f16vec2 data_d2[];};
#endif

#if BDA
layout (buffer_reference, buffer_reference_align = D_SIZE) buffer D_ptr {D_TYPE d;};
#endif

shared A_TYPE tile[TILE * (TILE + 1)];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint KHKW = p.KH * p.KW;
    const uint n_rows = p.OH_batch * p.OW;
    const uint delta_ic = ROW_STEP / KHKW;
    const uint delta_ky = (ROW_STEP % KHKW) / p.KW;
    const uint delta_kx = (ROW_STEP % KHKW) % p.KW;

    for (uint r0 = gl_WorkGroupID.y * TILE; r0 < n_rows; r0 += gl_NumWorkGroups.y * TILE) {
        const uint r = r0 + tid % TILE;
        const uint ow = r % p.OW;
        const uint oh = (r / p.OW) % p.OH;
        const uint batch_idx = r / (p.OW * p.OH);
        const int base_iw = int(ow * p.s0) - p.p0;
        const int base_ih = int(oh * p.s1) - p.p1;
        const uint src_batch = batch_idx * p.batch_offset;

        for (uint c0 = gl_WorkGroupID.x * TILE; c0 < p.CHW; c0 += gl_NumWorkGroups.x * TILE) {
            uint chw = c0 + tid / TILE;
            uint ic  = chw / KHKW;
            uint rem = chw % KHKW;
            uint ky  = rem / p.KW;
            uint kx  = rem % p.KW;
            [[unroll]] for (uint i = 0; i < TILE * TILE / WG_SIZE; ++i) {
                A_TYPE val = A_TYPE(0);
                const int iih = base_ih + int(ky * p.d1);
                const int iiw = base_iw + int(kx * p.d0);
                if (r < n_rows && chw < p.CHW && uint(iih) < p.IH && uint(iiw) < p.IW) {
                    val = data_a[src_batch + ic * p.offset_delta + uint(iih) * p.IW + uint(iiw)];
                }
                tile[(tid / TILE + i * ROW_STEP) * (TILE + 1) + tid % TILE] = val;

                chw += ROW_STEP;
                kx  += delta_kx;
                ky  += delta_ky;
                ic  += delta_ic;
                const uint kx_wrap = uint(kx >= p.KW);
                kx -= kx_wrap * p.KW;
                ky += kx_wrap;
                const uint ky_wrap = uint(ky >= p.KH);
                ky -= ky_wrap * p.KH;
                ic += ky_wrap;
            }
            barrier();

#if D_SIZE == 2 && !BDA
            // pairs of halves keep the stores 32-bit wide
            if (p.CHW % 2 == 0) {
                const uint cl = 2 * (tid % (TILE / 2));
                const uint chw_w = c0 + cl;
                [[unroll]] for (uint i = 0; i < TILE * TILE / (2 * WG_SIZE); ++i) {
                    const uint rl = tid / (TILE / 2) + i * (2 * ROW_STEP);
                    if (r0 + rl < n_rows && chw_w < p.CHW) {
                        data_d2[((r0 + rl) * p.CHW + chw_w) / 2] =
                            f16vec2(vec2(tile[cl * (TILE + 1) + rl], tile[(cl + 1) * (TILE + 1) + rl]));
                    }
                }
                barrier();
                continue;
            }
#endif
            const uint chw_w = c0 + tid % TILE;
            [[unroll]] for (uint i = 0; i < TILE * TILE / WG_SIZE; ++i) {
                const uint rl = tid / TILE + i * ROW_STEP;
                if (r0 + rl < n_rows && chw_w < p.CHW) {
                    const BDA_OFFSET_T dst_idx = BDA_OFFSET_T(r0 + rl) * p.CHW + chw_w;
                    const float v = float(tile[(tid % TILE) * (TILE + 1) + rl]);
#if BDA
                    D_ptr(p.dst_addr + D_SIZE * dst_idx).d = D_TYPE(v);
#else
                    data_d[dst_idx] = D_TYPE(v);
#endif
                }
            }
            barrier();
        }
    }
}
